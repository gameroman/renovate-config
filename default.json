{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["gameroman"],
  "reviewers": ["gameroman"],
  "assignAutomerge": true,
  "minimumReleaseAge": "34 hours",
  "internalChecksFilter": "strict",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageAction": "update",
  "packageRules": [
    { "matchPackagePatterns": ["*"], "semanticCommitType": "chore" },
    {
      "matchDatasources": ["npm"],
      "changelogUrl": "https://main.npmx.dev/diff/{{{depName}}}/v/{{{currentVersion}}}...{{{newVersion}}}",
      "prBodyDefinitions": {
        "Package": "[{{{depName}}}](https://main.npmx.dev/package/{{{depName}}}){{#if repositoryUrl}} ([source]({{{repositoryUrl}}})){{/if}}",
        "Change": "[`{{{currentVersion}}}` → `{{{newVersion}}}`](https://main.npmx.dev/diff/{{{depName}}}/v/{{{currentVersion}}}...{{{newVersion}}})"
      }
    },
    {
      "matchPackageNames": [
        "oxlint",
        "oxfmt",
        "oxlint-tsgolint",
        "@biomejs/biome",
        "@gameroman/config"
      ],
      "groupName": "lint and format tools"
    },
    { "matchPackageNames": ["typescript"], "groupName": "typescript" },
    {
      "matchPackageNames": ["wrangler", "@cloudflare/vite-plugin"],
      "groupName": "wrangler and @cloudflare/vite-plugin"
    },
    {
      "matchPackageNames": ["astro", "@astrojs/*"],
      "groupName": "astro dependencies"
    },
    { "matchPackageNames": ["solid-js"], "groupName": "solid-js" },
    {
      "matchPackageNames": ["tsdown", "rolldown-plugin-dts", "rolldown"],
      "groupName": "tsdown and rolldown"
    },
    { "matchPackageNames": ["grammy"], "groupName": "grammy" },
    { "matchPackageNames": ["esbuild"], "groupName": "esbuild" },
    {
      "matchPackageNames": ["tailwindcss", "@tailwindcss/*"],
      "groupName": "tailwindcss"
    },
    {
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "react and react-dom"
    }
  ]
}
